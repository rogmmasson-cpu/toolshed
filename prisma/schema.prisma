generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id // Clerk user ID
  name                 String
  email                String   @unique
  avatarUrl            String?
  bio                  String?
  locationCity         String   @default("")
  locationState        String   @default("")
  locationNeighborhood String?
  locationLat          Float    @default(0)
  locationLng          Float    @default(0)
  trustScore           Int      @default(50)
  badges               String[]
  memberSince          DateTime @default(now())
  responseRate         Float    @default(0)
  responseTimeHours    Float    @default(24)
  totalListings        Int      @default(0)
  totalRentals         Int      @default(0)
  totalLends           Int      @default(0)

  listings       Listing[]
  rentals        Booking[]  @relation("RenterBookings")
  lends          Booking[]  @relation("OwnerBookings")
  reviewsWritten Review[]   @relation("ReviewAuthor")
  messagesSent   Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id])
  title       String
  description String
  category    String
  condition   String
  brand       String?
  model       String?
  retailValue Int

  photos      String[]
  tags        String[]
  accessories String[]

  locationAddress      String @default("")
  locationNeighborhood String @default("")
  locationCity         String
  locationState        String
  locationLat          Float
  locationLng          Float

  dailyRate          Int
  weekendRate        Int?
  weeklyRate         Int?
  monthlyRate        Int?
  depositAmount      Int
  insuranceAvailable Boolean @default(false)
  insuranceDailyRate Int?

  blockedDates  String[]
  minRentalDays Int     @default(1)
  maxRentalDays Int?
  instantBook   Boolean @default(true)

  isBundle          Boolean  @default(false)
  bundledListingIds String[]
  bundleDiscount    Float    @default(0)

  averageRating Float @default(0)
  reviewCount   Int   @default(0)
  totalRentals  Int   @default(0)
  viewCount     Int   @default(0)

  status      String    @default("active")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]
  reviews  Review[]
  disputes Dispute[]

  @@index([ownerId])
  @@index([category])
  @@index([locationCity])
}

model Booking {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  renterId  String
  renter    User    @relation("RenterBookings", fields: [renterId], references: [id])
  ownerId   String
  owner     User    @relation("OwnerBookings", fields: [ownerId], references: [id])
  qrCode    String  @default("")

  startDate String
  endDate   String
  totalDays Int

  dailyRate        Int
  subtotal         Int
  platformFee      Int
  insuranceFee     Int
  depositAmount    Int
  totalCharge      Int
  totalWithDeposit Int

  depositStatus String    @default("held")
  heldAmount    Int
  releasedAt    DateTime?
  claimedAmount Int       @default(0)
  claimReason   String?

  waiverSigned    Boolean   @default(false)
  waiverSignedAt  DateTime?
  waiverIpAddress String?

  insuranceEnrolled Boolean @default(false)
  insuranceProvider String?
  insurancePolicyId String?

  checkInCompleted  Boolean   @default(false)
  checkInAt         DateTime?
  checkInMethod     String?
  checkOutCompleted Boolean   @default(false)
  checkOutAt        DateTime?
  checkOutMethod    String?

  status         String @default("pending")
  renterReviewId String?
  ownerReviewId  String?
  conversationId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disputes Dispute[]

  @@index([renterId])
  @@index([ownerId])
  @@index([listingId])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  targetType String
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id])

  overallRating       Float
  accuracyRating      Float?
  communicationRating Float?
  conditionRating     Float?
  reliabilityRating   Float?

  content   String
  response  String?
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([listingId])
}

model Conversation {
  id                 String   @id @default(cuid())
  participantIds     String[]
  listingId          String?
  bookingId          String?
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String   @default("")

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  attachments    String[]
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model Dispute {
  id                 String  @id @default(cuid())
  bookingId          String
  booking            Booking @relation(fields: [bookingId], references: [id])
  listingId          String
  listing            Listing @relation(fields: [listingId], references: [id])
  renterId           String
  ownerId            String
  filedByRole        String
  reason             String
  status             String  @default("open")
  resolution         String?
  resolutionNote     String?
  depositClaimAmount Int?

  timeline   DisputeEvent[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([renterId])
  @@index([ownerId])
}

model DisputeEvent {
  id         String  @id @default(cuid())
  disputeId  String
  dispute    Dispute @relation(fields: [disputeId], references: [id])
  type       String
  authorRole String
  authorName String
  content    String

  createdAt DateTime @default(now())
}

model Group {
  id            String   @id @default(cuid())
  name          String
  description   String
  neighborhood  String   @default("")
  city          String
  state         String   @default("")
  coverImageUrl String?
  adminId       String
  memberIds     String[]
  rules         String[]
  isPrivate     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
}
